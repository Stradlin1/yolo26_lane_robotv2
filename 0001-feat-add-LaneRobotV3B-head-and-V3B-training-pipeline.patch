+# Ultralytics 🚀 AGPL-3.0 License
+
+# YOLO26 LaneRobotV3B model: P4+P5 fusion + per-lane row-shared classifiers.
+# Same backbone/neck and output protocol as yolo26s-lane.yaml, but the head is
+# replaced by LaneRobotV3B:
+#   conv_1x1 256->16 -> bilinear row sampling (56 anchor rows)
+#   -> per-row flatten (16x28) + row mean -> 464 -> proj 464->512
+#   -> + row embedding -> 4 per-lane cls (512->321) + 4 per-lane offset (512->1)
+# Target input: 256x448 (H=256, W=448), both divisible by 32.
+# Output: {cls: [B, x_grids+1, row_anchors, num_lanes], offset: [B, 1, row_anchors, num_lanes]}.
+
+# Parameters
+nc: 4
+task: lane
+x_grids: 320
+row_anchors: 56
+num_lanes: 4
+reduce_channels: 16
+hidden_dim: 512
+feat_h: 16
+feat_w: 28
+y_start: 0.333333
+y_end: 1.0
+scales:
+  n: [0.50, 0.25, 1024]
+  s: [0.50, 0.50, 1024]
+  m: [0.50, 1.00, 512]
+  l: [1.00, 1.00, 512]
+  x: [1.00, 1.50, 512]
+
+backbone:
+  - [-1, 1, Conv, [64, 3, 2]] # 0-P1/2
+  - [-1, 1, Conv, [128, 3, 2]] # 1-P2/4
+  - [-1, 2, C3k2, [256, False, 0.25]]
+  - [-1, 1, Conv, [256, 3, 2]] # 3-P3/8
+  - [-1, 2, C3k2, [512, False, 0.25]]
+  - [-1, 1, Conv, [512, 3, 2]] # 5-P4/16
+  - [-1, 2, C3k2, [512, True]]
+  - [-1, 1, Conv, [1024, 3, 2]] # 7-P5/32
+  - [-1, 2, C3k2, [1024, True]]
+  - [-1, 1, SPPF, [1024, 5, 3, True]] # 9
+  - [-1, 2, C2PSA, [1024]] # 10, stride-32 deep feature
+
+head:
+  # P5 / stride-32 semantic feature reduction
+  - [10, 1, Conv, [256, 1, 1]] # 11
+  # Upsample P5 to P4 scale
+  - [-1, 1, nn.Upsample, [None, 2, nearest]] # 12
+  # P4 / stride-16 spatial feature reduction
+  - [6, 1, Conv, [256, 1, 1]] # 13
+  # P4 + P5 multi-scale fusion
+  - [[-1, -2], 1, Concat, [1]] # 14
+  - [-1, 1, Conv, [512, 3, 1]] # 15
+  # LaneRobotV3B head: shared row features + per-lane classifiers
+  - [-1, 1, LaneRobotV3B, [x_grids, row_anchors, num_lanes, reduce_channels, hidden_dim, feat_h, feat_w, y_start, y_end]] # 16
